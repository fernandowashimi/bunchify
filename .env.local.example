# Server only. Do not prefix these for the browser.
SPOTIFY_CLIENT_ID=
# Set only when the Spotify app is a confidential client.
SPOTIFY_CLIENT_SECRET=
# Must match a redirect URI on the Spotify app, including this callback path.
# Local: http://127.0.0.1:3000/api/auth/callback
# Opening the app on localhost is fine: login moves to this host before Spotify.
# Production: https://<host>/api/auth/callback
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback
SPOTIFY_ACCOUNTS_URL=https://accounts.spotify.com
SPOTIFY_API_URL=https://api.spotify.com

# PostHog — project token from https://app.posthog.com/project/settings
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
